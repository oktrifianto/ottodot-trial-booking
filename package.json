{
	"name": "ottodot-trial-booking",
	"private": true,
	"packageManager": "pnpm@10.17.1",
	"scripts": {
        "db:up": "docker compose up -d",
        "db:down": "docker compose down",
        "db:logs": "docker compose logs -f db",
        "migrate": "pnpm --filter backend migrate",
        "seed": "pnpm --filter backend seed",
		"dev:backend": "pnpm --dir backend start:dev",
		"dev:frontend": "pnpm --dir frontend dev",
        "dev": "pnpm --parallel --filter backend --filter frontend dev",
        "test": "pnpm --filter backend test"
	}
}
